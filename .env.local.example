# Required — Provider API key
OPENAI_API_KEY=sk-your-key-here

# Agent configuration (provider-agnostic)
# AGENT_PROVIDER=openai          # Options: openai (default)
# AGENT_MODEL=gpt-4o-mini        # Model name passed to the provider
# AGENT_TEMPERATURE=0.0          # 0.0 = deterministic

# OpenAI provider-specific
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REQUEST_TIMEOUT=30000
# OPENAI_MAX_RETRIES=3

# Optional — DummyJSON (demo data source)
# DUMMYJSON_BASE_URL=https://dummyjson.com
# DUMMYJSON_REQUEST_TIMEOUT=15000

# Database — PostgreSQL via docker compose (dev-start.sh lo levanta automaticamente)
# Sin esto la app funciona in-memory (sesiones se pierden al reiniciar)
DATABASE_URL=ecto://postgres:postgres@localhost/agentic_ui_dev

# Optional — Prompt mode (skip system prompt, use only business_prompt.eex)
# BUSINESS_PROMPT_ONLY=true
